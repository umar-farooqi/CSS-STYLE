/* -------------------- HEADER -------------------- */
.stock-header-pro {
    position: relative;
    padding: 18px 26px;
    border-radius: 14px;

    /* Soft professional gradient */
    background: linear-gradient(135deg,#0d3f1c,#13894a,#0f5c2d);

    display: flex;
    justify-content: space-between;
    align-items: center;

    box-shadow: 0 6px 18px rgba(0,0,0,0.18);

    transition: all .35s ease;
    overflow: hidden;
}

/* HOVER EFFECT */
.stock-header-pro:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(0,0,0,0.25);
}

/* LEFT SIDE */
.header-left {
    display: flex;
    flex-direction: column;
}

/* TITLE ROW */
.title-row {
    display: flex;
    align-items: center;
    gap: 6px;
}

/* ICON */
.header-icon {
    font-size: 14px;
}

/* MODULE TEXT */
.module-name {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #b9e3c8; /* Soft light green */
    font-weight: 600;
}

/* TITLE */
.stock-header-pro h3 {
    margin: 4px 0 0;
    font-size: 20px;
    color: #ffffff;
    font-weight: 600;
}

/* RIGHT SIDE */
.header-right {
    display: flex;
    align-items: center;
}

/* BADGE */
.status-badge {
    font-size: 12px;
    padding: 6px 16px;
    border-radius: 30px;

    background: rgba(255,255,255,0.18);
    color: #fff;

    backdrop-filter: blur(6px);

    font-weight: 500;
    letter-spacing: .5px;

    position: relative;
    overflow: hidden;
}

/* SHINE ANIMATION */
.report-animate::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 100%;
    height: 100%;

    background: linear-gradient(
        120deg,
        transparent,
        rgba(255,255,255,0.6),
        transparent
    );

    animation: shine 3s infinite;
}

@keyframes shine {
    100% {
        left: 120%;
    }
}

/* BOTTOM LINE */
.bottom-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;

    /* Soft gradient for accent */
    background: linear-gradient(90deg,#52b788,#b8e6c5,#52b788);

    opacity: .85;
}
